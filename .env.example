# Discord bot (existing)
DISCORD_TOKEN=

# Dashboard API (Wispbyte sets PORT)
PORT=

# Discord OAuth2 (server only — never put secret in the dashboard)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://yoshi507.github.io/Omnibot-dashboard/

# Comma-separated browser origins allowed to call the API
DASHBOARD_ORIGINS=https://yoshi507.github.io,http://localhost:5173

# Existing AI (optional)
GROQ_API_KEY=

# Optional
SESSION_SECRET=

# Optional: real GIF replies ([GIF: query] tags). Tenor preferred, Giphy fallback.
TENOR_API_KEY=
GIPHY_API_KEY=
