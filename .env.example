# Discord bot (existing)
DISCORD_TOKEN=

# Dashboard API (Wispbyte sets PORT)
PORT=

# Discord OAuth2 (server only — never put secret in the dashboard)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://omnibot.wisp.uno/auth/discord/callback

# Comma-separated browser origins allowed to call the API
DASHBOARD_ORIGINS=https://omnibot.wisp.uno,http://localhost:5173

# Existing AI (optional)
GROQ_API_KEY=

# Optional
SESSION_SECRET=

# Optional: real GIF replies ([GIF: query] tags). Tenor preferred, Giphy fallback.
TENOR_API_KEY=
GIPHY_API_KEY=

# Pollinations image generation (Flux only; shares the 20/day AI limit)
POLLINATIONS_API_KEY=

# Cloudflare Workers AI (preferred for image/video; Pollinations is fallback)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
