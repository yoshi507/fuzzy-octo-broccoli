# Discord bot (existing)
DISCORD_TOKEN=

# Dashboard API (Wispbyte sets PORT)
PORT=

# Discord OAuth2 (server only — never put secret in the dashboard)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://omnibot.wisp.uno/auth/discord/callback

# Comma-separated browser origins allowed to call the API
DASHBOARD_ORIGINS=https://omnibot.wisp.uno,http://localhost:5173

# Existing AI (optional)
GROQ_API_KEY=

# Optional
SESSION_SECRET=

# Optional: real GIF replies ([GIF: query] tags). Tenor preferred, Giphy fallback.
TENOR_API_KEY=
GIPHY_API_KEY=

# PixelForge / Home Mode image API (your site)
# Base site URL only — path defaults to /api/v1/generate
HOME_MODE_API_URL=https://free-ai-image-generator-black.vercel.app
# Optional API key from PixelForge "API Keys" page:
# HOME_MODE_API_KEY=
# HOME_MODE_API_PATH=/api/v1/generate

# Music — Spotify metadata (optional; streams via SoundCloud, not YouTube)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# SPOTIFY_MARKET=US
